# Copy this file to .env.local, then replace YOUR_DATABASE_PASSWORD.
# .env.local is ignored by git. Do not commit it, and do not put the password in chat.
#
# The app reads DATABASE_URL on the server. It does not read a Supabase
# browser key. Leave the other names unset unless you are running outside
# the hosted preview; the host fills those in on deploy.

# Session pooler, port 5432. Do not use the direct db.* host: it is IPv6-only.
DATABASE_URL=postgresql://postgres.vslquyowgxnkocxctods:YOUR_DATABASE_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Public Supabase sign-in. Safe to expose in the browser.
# VITE_SUPABASE_URL=https://vslquyowgxnkocxctods.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# SUPABASE_URL=https://vslquyowgxnkocxctods.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional. The public Vercel project must set these itself.
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_URL=https://your-app-origin
# BETTER_AUTH_SECRET=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
